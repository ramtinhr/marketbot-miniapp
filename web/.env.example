# Development: where `npm run dev` proxies /api to (the mini app's server).
API_PROXY_TARGET=http://127.0.0.1:8090

# Build time, optional: the bot's username without @, for the "open in
# Telegram" link shown when the app is opened in an ordinary browser.
# VITE_BOT_USERNAME=

# Where the image's nginx listens (docker-compose.yml).
WEB_PORT=8082
