# Serves the built mini app and proxies its server, so the app sees one origin.
# ${API_UPSTREAM} is the mini app's server, e.g. http://127.0.0.1:8090.
# ${WEB_HOST}:${WEB_PORT} is where this listens; in production it sits behind
# a TLS nginx, since Telegram only opens Mini Apps over HTTPS.

server {
    listen ${WEB_HOST}:${WEB_PORT};
    server_name _;
    root /usr/share/nginx/html;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    gzip on;
    gzip_types application/json application/javascript text/css image/svg+xml;
    gzip_min_length 1024;

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location /fonts/ {
        add_header Cache-Control "public, max-age=604800";
        try_files $uri =404;
    }

    # The trade page's live book: a WebSocket, kept open (the server pings every 30s).
    location = /api/v1/market/ws {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade         $http_upgrade;
        proxy_set_header Connection      "upgrade";
        proxy_set_header Host            $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 120s;
    }

    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host            $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 60s;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
