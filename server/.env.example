# HTTP server. The web app's nginx (and Vite in development) proxies /api here.
HOST=0.0.0.0
PORT=8090
LOG_LEVEL=info

# Where users reach the app (https://..., no trailing slash): the payment
# gateway sends the browser back to $PUBLIC_URL/api/v1/payments/callback.
# Required with PAYMENT_PROVIDER=zarinpal.
PUBLIC_URL=
# The bot's username without @, for the "back to Telegram" link after paying.
BOT_USERNAME=

# Postgres - the bot's database. The mini app keeps its own tables there
# (miniapp_*), created on first use. Wallets, orders and trades are the
# exchange engine's (schema "exchange"): the engine must have started once
# against this database so that schema exists.
DB_HOST=localhost
DB_PORT=5432
DB_USER=marketbot
DB_PASSWORD=marketbot123
DB_NAME=marketbot
DB_SSLMODE=disable

# The token of the bot the Mini App is opened from (BotFather). Telegram signs
# the launch parameters and the shared phone number with a key derived from it;
# without it every sign-in answers 503.
BOT_TOKEN=

# How old the launch parameters may be (Telegram reissues them each time the
# app is opened) and how old a shared contact may be when it reaches us.
INIT_DATA_MAX_AGE_SECONDS=86400
CONTACT_MAX_AGE_SECONDS=600

# A session ends this long after sign-in, or after this long without a request.
# Reopening the app from Telegram signs in again without asking for the phone.
SESSION_TTL_HOURS=720
SESSION_IDLE_MINUTES=10080

# SMS one-time codes: once per session before any money page, and again for
# every withdrawal. "kavenegar" (the default in production) or "console",
# which writes codes to the log instead - development only, refused in
# production. The template is a Kavenegar verify template with one %token%.
SMS_PROVIDER=console
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=
OTP_TTL_SECONDS=120
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_HOUR=6

# Wallet charges. "zarinpal" (the default in production) or "fake", a demo
# gateway served by this app that credits real wallets without money - refused
# in production. ZARINPAL_SANDBOX defaults to true outside production.
PAYMENT_PROVIDER=fake
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=
CHARGE_MIN_TOMAN=10000
CHARGE_MAX_TOMAN=50000000

# The exchange engine's Kafka (comma-separated). Empty: the trade page shows
# no book and orders answer 503.
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=marketbot-miniapp
# Market orders are sent as limit orders this far (basis points) past the
# deepest level they need; whatever does not fill at once is cancelled.
MARKET_SLIPPAGE_BPS=50
